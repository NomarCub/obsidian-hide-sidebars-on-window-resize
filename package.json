{
  "name": "obsidian-hide-sidebars-when-narrow",
  "version": "1.2.0",
  "description": "This Obsidian plugin hides the sidebars when the window is resized to be narrower",
  "main": "main.js",
  "author": "Michael Hanson, NomarCub",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node esbuild.config.mts",
    "build": "node esbuild.config.mts production",
    "check": "npm run type-check && npm run lint && npm run format && npm audit",
    "type-check": "tsc",
    "lint": "biome lint && eslint",
    "lint:fix": "biome lint --fix && eslint --fix",
    "format": "biome format",
    "format:fix": "biome format --write",
    "version": "node version-bump.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "^1.13.1",
    "obsidian-typings": "6.29.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
